      "para_offset": null,
      "parent_type": null,
      "parent_id": null,
      "fallback": false,
      "fp": "eaccdd98e328c7c2",
      "kind": "list_item",
      "list_id": 0,
      "item_depth": 1,
      "text": "Код водного объекта в государственном водном реестре — 08010300312110000014788",
      "n_chars": 78
    },
    {
      "id": 5,
      "start": 4022,
