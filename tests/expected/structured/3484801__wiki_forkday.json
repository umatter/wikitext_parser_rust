      "fp": "c86f44c00cecef58",
      "kind": "list_item",
      "list_id": 0,
      "item_depth": 1,
      "text": "Номинация «GLAAD Media Awards» за «лучший документальный фильм», 2008",
      "n_chars": 69
    },
