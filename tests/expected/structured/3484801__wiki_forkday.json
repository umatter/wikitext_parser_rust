      "fallback": false,
      "fp": "aa23ff9dc9411a84",
      "kind": "list_item",
      "list_id": 0,
      "item_depth": 1,
      "text": "Номинация на премию жюри на кинофестивале «Sundance», 2006",
      "n_chars": 58
    },
    {
      "id": 5,
      "start": 4389,
      "end": 4504,
      "start_char": 2933,
      "end_char": 3008,
      "section_id": 2,
